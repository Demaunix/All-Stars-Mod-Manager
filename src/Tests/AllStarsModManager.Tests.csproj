<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>AllStarsModManager.Tests</RootNamespace>
    <AssemblyName>AllStarsModManager.Tests</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- The project paths can be overridden (-p:AppProject=... -p:CoreProject=...) to build the same tests against another copy of the sources. -->
    <AppProject Condition="'$(AppProject)' == ''">..\App\AllStarsModManager.App.csproj</AppProject>
    <CoreProject Condition="'$(CoreProject)' == ''">..\Core\AllStarsModManager.Core.csproj</CoreProject>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('Private')">
    <!-- Tests that need private local inputs live in Private\ (excluded from the public source tree). -->
    <DefineConstants>$(DefineConstants);PRIVATE_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <ProjectReference Include="$(CoreProject)" />
    <ProjectReference Include="$(AppProject)" />
    <ProjectReference Include="..\StubGame\StubGame.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
