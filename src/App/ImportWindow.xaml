<local:ThemedWindow x:Class="AllStarsModManager.App.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AllStarsModManager.App"
        Title="Add mod" Width="720" Height="620" MinWidth="560" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="ImportWindow">
    <local:ThemedWindow.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </local:ThemedWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Height="0"/>
        <Grid Grid.Row="1" Margin="24,18,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Add mod" Style="{StaticResource PageTitle}" FontSize="18"/>
            <TextBlock x:Name="SourceText" Grid.Row="1" Margin="0,4,0,2" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ImportSource"/>
            <Border Grid.Row="2" Margin="0,6,0,10" Padding="10,7" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="2">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.AutomationId="ImportStatus"/>
            </Border>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <ProgressBar x:Name="Bar" IsIndeterminate="True" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="ProblemList" ItemTemplate="{StaticResource NoteTemplate}" IsTabStop="False" AutomationProperties.AutomationId="ImportProblems"/>
                    <ItemsControl x:Name="ModList" IsTabStop="False" AutomationProperties.AutomationId="ImportMods">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ImportItemVM}">
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,2,12,0" AutomationProperties.AutomationId="{Binding CheckId}" AutomationProperties.Name="{Binding Name}"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Version}" Foreground="{StaticResource MutedBrush}" Margin="10,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Line}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,6" TextWrapping="Wrap"/>
                                            <ContentControl Content="{Binding Chips}" IsTabStop="False">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate>
                                                        <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource ChipTemplate}" IsTabStop="False"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                            <ItemsControl ItemsSource="{Binding Notes}" Margin="0,4,0,0" IsTabStop="False">
                                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/></DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" MinWidth="96" Margin="0,0,8,0" IsCancel="True" AutomationProperties.AutomationId="ImportCancelButton"/>
                <Button x:Name="AddButton" Content="Add to library" Click="Add_Click" Style="{StaticResource PrimaryButton}" MinWidth="150" IsEnabled="False" AutomationProperties.AutomationId="ImportAddButton"/>
            </StackPanel>
        </Border>
    </Grid>
</local:ThemedWindow>
