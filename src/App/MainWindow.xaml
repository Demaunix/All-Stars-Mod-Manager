<local:ThemedWindow x:Class="AllStarsModManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AllStarsModManager.App"
        Title="All-Stars Mod Manager" Width="1100" Height="760" MinWidth="880" MinHeight="480"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        AutomationProperties.AutomationId="MainWindow">
    <local:ThemedWindow.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <DataTemplate x:Key="ChipsTemplate">
            <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource ChipTemplate}" IsTabStop="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- Banner: a flat notice strip. Kind shows as an edge, an icon AND words. -->
        <DataTemplate x:Key="BannerTemplate" DataType="{x:Type local:BannerVM}">
            <Border x:Name="Bd" Padding="0,5,10,5" Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Text}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Rectangle x:Name="Bar" Fill="{StaticResource AccentEdgeBrush}" Margin="0,-5,0,-5"/>
                    <Path x:Name="Ico" Grid.Column="1" Style="{StaticResource IconStroke}" Data="{StaticResource IconInfo}" Stroke="{StaticResource InfoBrush}" Width="14" Height="14" Margin="10,0,8,0"/>
                    <TextBlock x:Name="Tx" Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Content="{Binding ActionText}" Command="{Binding Action}" Padding="10,1" MinHeight="22" Visibility="{Binding HasAction, Converter={StaticResource B2V}}" Margin="0,0,8,0"/>
                        <Button Content="{Binding SecondActionText}" Command="{Binding SecondAction}" Style="{StaticResource LinkButton}" Visibility="{Binding HasSecondAction, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Warn">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource WarnBgBrush}"/>
                    <Setter TargetName="Bar" Property="Fill" Value="{StaticResource WarnBrush}"/>
                    <Setter TargetName="Ico" Property="Data" Value="{StaticResource IconWarn}"/><Setter TargetName="Ico" Property="Stroke" Value="{StaticResource WarnBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Danger">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerBgBrush}"/>
                    <Setter TargetName="Bar" Property="Fill" Value="{StaticResource DangerBrush}"/>
                    <Setter TargetName="Ico" Property="Data" Value="{StaticResource IconCross}"/><Setter TargetName="Ico" Property="Stroke" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The same banner list on both pages -->
        <Style x:Key="BannerList" TargetType="ItemsControl">
            <Setter Property="ItemsSource" Value="{Binding Banners}"/>
            <Setter Property="ItemTemplate" Value="{StaticResource BannerTemplate}"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
                        <Setter Property="AutomationProperties.Name" Value="{Binding Text}"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FactTemplate" DataType="{x:Type local:FactVM}">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>

        <!-- One row of the mod table. Columns line up with the captions above: tick box, name, id, version, state, file check.
             A second line appears only when a row has something to flag (pending change, conflict, note). -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:ModRowVM}">
            <Grid>
                <Rectangle Width="3" HorizontalAlignment="Left" Margin="-8,-3,0,-3" Fill="{StaticResource WarnBrush}" Visibility="{Binding HasPending, Converter={StaticResource B2V}}"/>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanToggle}" ToolTip="{Binding CheckTip}" VerticalAlignment="Center" Margin="0,0,10,0"
                              AutomationProperties.AutomationId="{Binding CheckAutomationId}" AutomationProperties.Name="{Binding Name}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding NameTip}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StateKey}" Value="Off"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding StateKey}" Value="Library"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding IdText}" Width="170" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"
                               ToolTip="{Binding IdText}" Visibility="{Binding DataContext.ShowIdColumn, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource B2V}}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Version}" Width="104" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding Version}"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Width="118" VerticalAlignment="Center" ToolTip="{Binding StateTip}">
                        <Path x:Name="StateIco" Style="{StaticResource IconStroke}" Width="10" Height="10" Margin="0,0,6,0" Data="{StaticResource IconRing}" Stroke="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding StateText}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Width="92" VerticalAlignment="Center" ToolTip="{Binding CheckTip2}">
                        <Path x:Name="CheckIco" Style="{StaticResource IconStroke}" Width="10" Height="10" Margin="0,0,5,0" Visibility="Collapsed" Stroke="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="CheckTx" Text="{Binding CheckText}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" AutomationProperties.Name="{Binding CheckFull}"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Margin="0,2,0,1" Visibility="{Binding HasFlagsLine, Converter={StaticResource B2V}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,2" VerticalAlignment="Top" Visibility="{Binding HasPending, Converter={StaticResource B2V}}">
                            <Path Style="{StaticResource IconStroke}" Width="10" Height="10" Margin="0,1,5,0" Data="{StaticResource IconClock}" Stroke="{StaticResource WarnBrush}"/>
                            <TextBlock Text="{Binding PendingText}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource WarnBrush}" AutomationProperties.AutomationId="{Binding AutomationId, StringFormat='Pending_{0}'}"/>
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Flags}" ItemTemplate="{StaticResource ChipTemplate}" IsTabStop="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="On">
                    <Setter TargetName="StateIco" Property="Data" Value="{StaticResource IconDotOn}"/>
                    <Setter TargetName="StateIco" Property="Fill" Value="{StaticResource OkBrush}"/>
                    <Setter TargetName="StateIco" Property="Stroke" Value="{StaticResource OkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="Library">
                    <Setter TargetName="StateIco" Property="Data" Value="{StaticResource IconDiamond}"/>
                    <Setter TargetName="StateIco" Property="Stroke" Value="{StaticResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckKind}" Value="Ok">
                    <Setter TargetName="CheckIco" Property="Visibility" Value="Visible"/><Setter TargetName="CheckIco" Property="Data" Value="{StaticResource IconCheck}"/><Setter TargetName="CheckIco" Property="Stroke" Value="{StaticResource OkBrush}"/>
                    <Setter TargetName="CheckTx" Property="Foreground" Value="{StaticResource OkBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckKind}" Value="Danger">
                    <Setter TargetName="CheckIco" Property="Visibility" Value="Visible"/><Setter TargetName="CheckIco" Property="Data" Value="{StaticResource IconCross}"/><Setter TargetName="CheckIco" Property="Stroke" Value="{StaticResource DangerBrush}"/>
                    <Setter TargetName="CheckTx" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CheckText}" Value="Checking">
                    <Setter TargetName="CheckIco" Property="Visibility" Value="Visible"/><Setter TargetName="CheckIco" Property="Data" Value="{StaticResource IconDots}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="RowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource RowItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}"/>
        </Style>

        <!-- Caption above a table column -->
        <Style x:Key="ColumnHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </local:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Pages: compact tabs directly under the title bar. -->
        <TabControl x:Name="Pages" Style="{StaticResource PageTabControl}" SelectedIndex="{Binding SelectedPage, Mode=TwoWay}" AutomationProperties.AutomationId="PageTabs">
            <TabItem Header="Mods" Style="{StaticResource PageTabItem}" AutomationProperties.AutomationId="TabMods">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5*" MinHeight="80"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="3*" MinHeight="100"/>
                    </Grid.RowDefinitions>

                    <ItemsControl Grid.Row="0" Style="{StaticResource BannerList}" AutomationProperties.AutomationId="Banners"/>

                    <!-- The chosen game and its state: a slim strip, like the game name in the other managers' title. -->
                    <Grid Grid.Row="1" Margin="12,6,12,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Game:" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding GameTitle}" FontWeight="SemiBold" Margin="0,0,10,0" AutomationProperties.AutomationId="GameTitle"/>
                            <TextBlock Text="{Binding GamePath}" ToolTip="{Binding GamePath}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="520" AutomationProperties.AutomationId="GamePath"/>
                        </StackPanel>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding HeaderChips}" ItemTemplate="{StaticResource ChipTemplate}" MaxWidth="460" HorizontalAlignment="Right" IsTabStop="False" Margin="12,0,0,0" AutomationProperties.AutomationId="HeaderChips">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Right"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                    <!-- Search, show filter, profile -->
                    <Grid Grid.Row="2" Margin="12,6,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,8,0">
                            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="Search mods" VerticalContentAlignment="Center" Padding="26,3,6,3"
                                     ToolTip="Search by name, ID or version (Ctrl+F)"/>
                            <Path Style="{StaticResource IconStroke}" Data="{StaticResource IconSearch}" Stroke="{StaticResource MutedBrush}" Width="12" Height="12" HorizontalAlignment="Left" Margin="8,0,0,0"/>
                            <TextBlock Text="Search mods by name, ID or version…" Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="26,0,0,0" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0">
                            <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox ItemsSource="{Binding FilterNames}" SelectedIndex="{Binding FilterIndex, Mode=TwoWay}" Width="124" VerticalContentAlignment="Center" AutomationProperties.AutomationId="FilterCombo" AutomationProperties.Name="Show"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="Profile" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}"/>
                            <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}" Width="124" VerticalContentAlignment="Center" AutomationProperties.AutomationId="ProfileCombo" AutomationProperties.Name="Profile"/>
                            <Button Content="Save as…" Command="{Binding SaveProfileCommand}" Margin="6,0,0,0" Padding="10,3" AutomationProperties.AutomationId="SaveProfileButton"/>
                            <Button x:Name="ProfileMoreButton" Content="More ▾" Click="ProfileMore_Click" Margin="6,0,0,0" Padding="10,3" ToolTip="Reload, rename or delete this profile" AutomationProperties.AutomationId="ProfileMoreButton"/>
                        </StackPanel>
                    </Grid>

                    <!-- The mod table: full width -->
                    <Border Grid.Row="3" Margin="12,0,12,0" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                <Grid Margin="8,0,20,0" Height="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26"/>
                                    <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource ColumnHead}"/>
                                    <TextBlock Grid.Column="2" Text="Mod ID" Width="180" Style="{StaticResource ColumnHead}" Visibility="{Binding ShowIdColumn, Converter={StaticResource B2V}}"/>
                                    <TextBlock Grid.Column="3" Text="Version" Width="114" Style="{StaticResource ColumnHead}"/>
                                    <TextBlock Grid.Column="4" Text="State" Width="118" Style="{StaticResource ColumnHead}"/>
                                    <TextBlock Grid.Column="5" Text="Files" Width="92" Style="{StaticResource ColumnHead}"/>
                                </Grid>
                            </Border>
                            <ListBox x:Name="ModList" Grid.Row="1" ItemsSource="{Binding View}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" ItemTemplate="{StaticResource RowTemplate}" ItemContainerStyle="{StaticResource RowContainer}"
                                     Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible" VirtualizingPanel.IsVirtualizing="False"
                                     PreviewKeyDown="ModList_PreviewKeyDown" SizeChanged="ModList_SizeChanged"
                                     AutomationProperties.AutomationId="ModList" AutomationProperties.Name="Mods"/>
                            <!-- empty states: plain words and one button -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource B2V}}" MaxWidth="440" Margin="20">
                                <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="13" AutomationProperties.AutomationId="EmptyText"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <Button Content="Choose game folder…" Command="{Binding SettingsCommand}" AutomationProperties.AutomationId="EmptyChooseButton">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding EmptyIsNoGame}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                    </Button>
                                    <Button Content="Add mod…" Command="{Binding AddModCommand}" AutomationProperties.AutomationId="EmptyAddButton">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding EmptyIsNoGame}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding NoMatches, Converter={StaticResource B2V}}" MaxWidth="440" Margin="20">
                                <TextBlock Text="No mods match your search or filter." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="13" AutomationProperties.AutomationId="NoMatchText"/>
                                <Button Content="Clear search and filter" Command="{Binding ClearFilterCommand}" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,8,0,0" AutomationProperties.AutomationId="ClearFilterButton"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Buttons under the table, like Add Mod / Refresh List in the other managers; the count sits on the right. -->
                    <Grid Grid.Row="4" Margin="12,6,12,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AddButton" Command="{Binding AddModCommand}" Padding="12,3" AutomationProperties.AutomationId="AddModButton" AutomationProperties.Name="Add mod…"
                                    ToolTip="Add a mod from a folder or .zip. You can also drop them onto this window.">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconStroke}" Data="{StaticResource IconPlus}" Stroke="{StaticResource OkBrush}" Width="11" Height="11" StrokeThickness="2" Margin="0,0,7,0"/>
                                    <TextBlock Text="Add mod…"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="6,0,0,0" ToolTip="Read the game folder again (F5)" AutomationProperties.AutomationId="RefreshButton"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ListSummary}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ListSummary"/>
                            <TextBlock Text="{Binding ShownText}" Foreground="{StaticResource FaintBrush}" Margin="12,0,0,0" AutomationProperties.AutomationId="ShownText"/>
                        </StackPanel>
                    </Grid>

                    <GridSplitter Grid.Row="5" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="12,0,12,0"
                                  ToolTip="Drag (or use the up and down arrow keys) to resize the details" AutomationProperties.AutomationId="DetailsSplitter" AutomationProperties.Name="Resize details"/>

                    <!-- Details of the selected mod, beneath the table (like the Description area of SA Mod Manager) -->
                    <Grid Grid.Row="6" Margin="12,0,12,8">
                        <TextBlock Text="Select a mod to see its details. Space switches the selected mod on or off." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="2,6,0,0" Visibility="{Binding NoDetails, Converter={StaticResource B2V}}"/>
                        <Grid Visibility="{Binding HasDetails, Converter={StaticResource B2V}}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid DataContext="{Binding Details}" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="DetailTitle"/>
                                    <TextBlock Text="{Binding SubTitle}" ToolTip="{Binding SubTitle}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="DetailSubtitle"/>
                                </StackPanel>
                                <ContentControl Grid.Column="1" Content="{Binding Chips}" ContentTemplate="{StaticResource ChipsTemplate}" IsTabStop="False" MaxWidth="480" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16,3,0,0"/>
                            </Grid>
                            <TabControl x:Name="DetailTabs" Grid.Row="1" AutomationProperties.AutomationId="DetailTabs">
                                <TabItem Header="Overview" AutomationProperties.AutomationId="TabOverview">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                        <Grid DataContext="{Binding Details}" Margin="0,0,8,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding StatusLong}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Visibility="{Binding HasStatus, Converter={StaticResource B2V}}"/>
                                                <StackPanel Visibility="{Binding HasSummary, Converter={StaticResource B2V}}">
                                                    <TextBlock Text="DESCRIPTION" Style="{StaticResource SectionTitle}"/>
                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Text="WHERE IT IS" Style="{StaticResource SectionTitle}"/>
                                                <TextBlock Text="{Binding WhereText}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <StackPanel Visibility="{Binding HasProblems, Converter={StaticResource B2V}}">
                                                    <TextBlock Text="THINGS TO KNOW" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                    <ItemsControl ItemsSource="{Binding Problems}" ItemTemplate="{StaticResource NoteTemplate}" IsTabStop="False"/>
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding NeedsManifestChoice, Converter={StaticResource B2V}}">
                                                    <TextBlock Text="SWITCHED-OFF MANIFESTS" Style="{StaticResource SectionTitle}"/>
                                                    <TextBlock Text="This folder has several. Choose the one to use when switching it on." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
                                                    <ComboBox ItemsSource="{Binding ManifestChoices}" SelectionChanged="ManifestChoice_Changed" Margin="0,6,0,0" AutomationProperties.AutomationId="ManifestChoiceCombo" AutomationProperties.Name="Manifest to use"/>
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding HasPersistence, Converter={StaticResource B2V}}">
                                                    <TextBlock Text="BEFORE YOU SWITCH IT OFF" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding PersistenceNote}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding HasRequirements, Converter={StaticResource B2V}}">
                                                    <TextBlock Text="STILL TO TEST IN THE GAME" Style="{StaticResource SectionTitle}"/>
                                                    <ItemsControl ItemsSource="{Binding Requirements}" IsTabStop="False">
                                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,3" Foreground="{StaticResource MutedBrush}"/></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- Actions; the one that moves a mod out of the game folder is red and set apart on the right. -->
                                            <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,4" LastChildFill="False">
                                                <WrapPanel DockPanel.Dock="Left">
                                                    <Button Content="Open folder" Click="OpenModFolder_Click" Margin="0,0,8,4" Visibility="{Binding CanOpenFolder, Converter={StaticResource B2V}}" AutomationProperties.AutomationId="OpenModFolderButton"/>
                                                    <Button Content="Check against game files" Click="DeepCheck_Click" Margin="0,0,8,4" ToolTip="Rebuilds each changed archive the way the loader does and compares the result." AutomationProperties.AutomationId="DeepCheckButton"/>
                                                </WrapPanel>
                                                <Border DockPanel.Dock="Right" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="12,0,0,0" Margin="12,0,0,0" Visibility="{Binding CanRemove, Converter={StaticResource B2V}}">
                                                    <Button Content="Remove from game folder…" Click="Uninstall_Click" Style="{StaticResource DangerButton}" AutomationProperties.AutomationId="UninstallButton"
                                                            ToolTip="Moves the mod folder out of the game's mods folder into the manager's backup area. Nothing is deleted; Undo last change puts it back."/>
                                                </Border>
                                            </DockPanel>
                                        </Grid>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Compatibility" AutomationProperties.AutomationId="TabCompat">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                        <StackPanel DataContext="{Binding Details}" Margin="0,0,8,0" MaxWidth="900" HorizontalAlignment="Left">
                                            <TextBlock Text="Based on the mods you currently have switched on, plus this one." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <ItemsControl ItemsSource="{Binding Compat}" ItemTemplate="{StaticResource NoteTemplate}" IsTabStop="False" AutomationProperties.AutomationId="CompatList"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Configure" AutomationProperties.AutomationId="TabSettings">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                        <StackPanel DataContext="{Binding Config}" Margin="0,0,8,0" MaxWidth="760" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Visibility="{Binding HasMessage, Converter={StaticResource B2V}}" Margin="0,0,0,8"/>
                                            <Border Visibility="{Binding HasRuntimeNote, Converter={StaticResource B2V}}" Background="{StaticResource WarnBgBrush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="2" Padding="10,7" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource IconStroke}" Data="{StaticResource IconWarn}" Stroke="{StaticResource WarnBrush}" Width="13" Height="13" VerticalAlignment="Top" Margin="0,1,8,0"/>
                                                    <TextBlock Text="{Binding RuntimeNote}" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" MaxWidth="680"/>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel Visibility="{Binding Available, Converter={StaticResource B2V}}">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <ComboBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}" MinWidth="200" AutomationProperties.AutomationId="ConfigFileCombo" AutomationProperties.Name="Settings file"/>
                                                    <TextBlock Text="{Binding EncodingText}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Rows}" IsTabStop="False" AutomationProperties.AutomationId="ConfigRows">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type local:ConfigRowVM}">
                                                            <Grid Margin="0,0,0,8">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <StackPanel Margin="0,4,10,0">
                                                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding SectionText}" Foreground="{StaticResource FaintBrush}" FontSize="11"/>
                                                                    <TextBlock Text="● edited" Foreground="{StaticResource WarnBrush}" FontSize="11" FontWeight="SemiBold" Visibility="{Binding Changed, Converter={StaticResource B2V}}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsText, Converter={StaticResource B2V}}" AutomationProperties.AutomationId="{Binding Key, StringFormat='Config_{0}'}" AutomationProperties.Name="{Binding Label}"/>
                                                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, Mode=TwoWay}" Visibility="{Binding IsEnum, Converter={StaticResource B2V}}" AutomationProperties.Name="{Binding Label}"/>
                                                                    <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}" Visibility="{Binding IsBool, Converter={StaticResource B2V}}" Content="On" Margin="0,5,0,0" AutomationProperties.Name="{Binding Label}"/>
                                                                    <TextBlock Text="{Binding Description}" Visibility="{Binding HasDescription, Converter={StaticResource B2V}}" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Visibility="{Binding HasError, Converter={StaticResource B2V}}" Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="2" Padding="10,7" Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Style="{StaticResource IconStroke}" Data="{StaticResource IconCross}" Stroke="{StaticResource DangerBrush}" Width="12" Height="12" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                                        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" MaxWidth="680" AutomationProperties.AutomationId="ConfigError"/>
                                                    </StackPanel>
                                                </Border>
                                                <WrapPanel Margin="0,2,0,0">
                                                    <Button Content="Save settings…" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" AutomationProperties.AutomationId="SaveSettingsButton"/>
                                                    <Button Content="Reset" Command="{Binding ResetCommand}" Margin="0,0,8,4" AutomationProperties.AutomationId="ResetSettingsButton"/>
                                                    <Button Content="Edit as text…" Command="{Binding EditTextCommand}" Margin="0,0,8,4" AutomationProperties.AutomationId="EditTextButton"/>
                                                    <Button Content="Open in editor" Command="{Binding OpenInEditorCommand}" Margin="0,0,8,4" AutomationProperties.AutomationId="OpenInEditorButton"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Files" AutomationProperties.AutomationId="TabFiles">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                        <StackPanel DataContext="{Binding Details}" Margin="0,0,8,0" MaxWidth="900" HorizontalAlignment="Left">
                                            <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource FactTemplate}" IsTabStop="False"/>
                                            <TextBlock Text="WHAT IT CHANGES" Style="{StaticResource SectionTitle}"/>
                                            <ItemsControl ItemsSource="{Binding Targets}" ItemTemplate="{StaticResource FactTemplate}" IsTabStop="False"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Manager settings" Style="{StaticResource PageTabItem}" AutomationProperties.AutomationId="TabManager">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <ItemsControl Grid.Row="0" Style="{StaticResource BannerList}" AutomationProperties.AutomationId="BannersSettings"/>
                    <local:SettingsPage Grid.Row="1" x:Name="SettingsView"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Action bar: stays in the same place on every page, like Save / Save and Play in the other managers. -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,8,12,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconClock}" Stroke="{StaticResource WarnBrush}" Width="13" Height="13" Margin="0,0,6,0">
                            <Path.Style><Style TargetType="Path" BasedOn="{StaticResource IconStroke}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasPendingChanges}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style>
                        </Path>
                        <TextBlock Text="{Binding PendingText}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="PendingText"/>
                    </StackPanel>
                    <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource AccentTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" AutomationProperties.AutomationId="BusyText"/>
                    <ProgressBar IsIndeterminate="True" Width="150" HorizontalAlignment="Left" Margin="0,3,0,0">
                        <ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Undo last change" Command="{Binding UndoLastCommand}" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.AutomationId="UndoLastButton"
                            ToolTip="Go back to how the mods folder was before the last applied change"/>
                    <Button Content="Open game folder" Command="{Binding OpenGameFolderCommand}" Margin="0,0,8,0" MinHeight="32" Padding="14,3" AutomationProperties.AutomationId="OpenFolderButton"/>
                    <Button Content="Discard" Command="{Binding DiscardCommand}" Margin="0,0,16,0" MinHeight="32" Padding="14,3" ToolTip="Forget the changes that are waiting; nothing in the game folder is touched" AutomationProperties.AutomationId="DiscardButton"/>
                    <Button Command="{Binding LaunchCommand}" ToolTip="{Binding LaunchTip}" Style="{StaticResource PlayButton}" Margin="0,0,8,0" MinWidth="100" MinHeight="32" AutomationProperties.AutomationId="PlayButton" AutomationProperties.Name="Play" AutomationProperties.HelpText="{Binding LaunchTip}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}" Fill="{StaticResource OkBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Play"/>
                        </StackPanel>
                    </Button>
                    <Button Content="{Binding ApplyText}" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" MinWidth="170" MinHeight="32" AutomationProperties.AutomationId="ApplyButton"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Drop hint -->
        <Border x:Name="DropOverlay" Grid.RowSpan="2" Background="#E61A1A1A" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid Margin="40">
                <Rectangle Stroke="{StaticResource AccentEdgeBrush}" StrokeThickness="2" StrokeDashArray="5 3"/>
                <TextBlock Text="Drop a mod folder or .zip to add it" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</local:ThemedWindow>
