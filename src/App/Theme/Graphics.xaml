<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Original vector graphics: a small flat star badge (used only as the window icon) and the small state icons.
      Nothing here is a bitmap, a screenshot or third-party artwork.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Palette.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Restrained app icon: blue disc, white star. Rendered once to a bitmap for the title bar and taskbar. -->
    <Style x:Key="LogoMark" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="40" Height="40">
                            <Ellipse Canvas.Left="2" Canvas.Top="2" Width="36" Height="36" Fill="#0F6CBD"/>
                            <Path Fill="#FFFFFF" Data="M 20,8 L 23.4,16.2 L 32.2,16.9 L 25.5,22.6 L 27.6,31.2 L 20,26.6 L 12.4,31.2 L 14.5,22.6 L 7.8,16.9 L 16.6,16.2 Z"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- State icons (16 x 16 box). Drawn as paths so they never depend on a symbol font. -->
    <Geometry x:Key="IconCheck">M 2.5,8.5 L 6.3,12.2 L 13.5,3.8</Geometry>
    <Geometry x:Key="IconCross">M 3.5,3.5 L 12.5,12.5 M 12.5,3.5 L 3.5,12.5</Geometry>
    <Geometry x:Key="IconWarn">M 8,2 L 14.5,13.5 L 1.5,13.5 Z M 8,6.5 L 8,9.7 M 8,11.6 L 8,11.7</Geometry>
    <Geometry x:Key="IconInfo">M 8,1.8 A 6.2,6.2 0 1 0 8.01,1.8 Z M 8,7.2 L 8,11.4 M 8,4.6 L 8,4.7</Geometry>
    <Geometry x:Key="IconDotOn">M 8,3.5 A 4.5,4.5 0 1 0 8.01,3.5 Z</Geometry>
    <Geometry x:Key="IconRing">M 8,3.5 A 4.5,4.5 0 1 0 8.01,3.5 Z</Geometry>
    <Geometry x:Key="IconDiamond">M 8,2.2 L 13.8,8 L 8,13.8 L 2.2,8 Z</Geometry>
    <Geometry x:Key="IconDots">M 3,8 L 3.1,8 M 8,8 L 8.1,8 M 13,8 L 13.1,8</Geometry>
    <Geometry x:Key="IconPlay">M 4,2.5 L 13.5,8 L 4,13.5 Z</Geometry>
    <Geometry x:Key="IconClock">M 8,1.8 A 6.2,6.2 0 1 0 8.01,1.8 Z M 8,4.6 L 8,8.2 L 10.6,9.8</Geometry>
    <Geometry x:Key="IconArrow">M 3,8 L 12.5,8 M 8.5,4 L 12.5,8 L 8.5,12</Geometry>
    <Geometry x:Key="IconPlus">M 8,2.5 L 8,13.5 M 2.5,8 L 13.5,8</Geometry>
    <Geometry x:Key="IconSearch">M 6,1.5 A 4.5,4.5 0 1 0 6.01,1.5 Z M 9.4,9.4 L 13.5,13.5</Geometry>

    <Style x:Key="IconStroke" TargetType="Path">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="StrokeThickness" Value="1.6"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
</ResourceDictionary>
