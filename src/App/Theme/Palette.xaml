<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      Neutral dark theme in the style of the familiar mod managers (SA Mod Manager, HedgeModManager): charcoal surfaces,
      thin ordinary borders, white regular-weight Segoe UI text, one restrained blue for the active tab, selection and the
      check-box tick. State colours are muted and every state also has a word and an icon, never colour alone.
      Text pairs are kept at WCAG AA (4.5:1) or better; the "theme" test reads these values.
    -->

    <!-- Fonts: the ordinary Windows UI font; Arial is only a fallback. -->
    <FontFamily x:Key="UiFont">Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Courier New</FontFamily>

    <!-- Surfaces -->
    <Color x:Key="WindowColor">#202020</Color>
    <Color x:Key="PanelColor">#272727</Color>
    <Color x:Key="InsetColor">#1A1A1A</Color>
    <Color x:Key="ButtonColor">#2D2D2D</Color>
    <Color x:Key="ButtonHoverColor">#3A3A3A</Color>
    <Color x:Key="ButtonPressColor">#454545</Color>
    <Color x:Key="LineColor">#4A4A4A</Color>
    <Color x:Key="LineSoftColor">#333333</Color>
    <Color x:Key="HoverRowColor">#2C2C2C</Color>
    <Color x:Key="SelectedColor">#1D4468</Color>

    <!-- Accent: the one blue (active tab, selection, tick, apply button) and a light blue for focus rings and links. -->
    <Color x:Key="AccentColor">#0F6CBD</Color>
    <Color x:Key="AccentEdgeColor">#4BA0EA</Color>
    <Color x:Key="AccentTextColor">#6CB8FF</Color>

    <!-- Text -->
    <Color x:Key="TextColor">#F2F2F2</Color>
    <Color x:Key="MutedColor">#B8B8B8</Color>
    <Color x:Key="FaintColor">#929292</Color>

    <!-- States -->
    <Color x:Key="OkColor">#6CCB5F</Color>
    <Color x:Key="OkBgColor">#1F3A22</Color>
    <Color x:Key="WarnColor">#F2C94C</Color>
    <Color x:Key="WarnBgColor">#3A3318</Color>
    <Color x:Key="DangerColor">#FF9A90</Color>
    <Color x:Key="DangerBgColor">#432424</Color>
    <Color x:Key="InfoColor">#86BFFF</Color>
    <Color x:Key="InfoBgColor">#1F3045</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}"/>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource WindowColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="InsetBrush" Color="{StaticResource InsetColor}"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="{StaticResource ButtonColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="{StaticResource ButtonHoverColor}"/>
    <SolidColorBrush x:Key="ButtonPressBrush" Color="{StaticResource ButtonPressColor}"/>
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="LineSoftBrush" Color="{StaticResource LineSoftColor}"/>
    <SolidColorBrush x:Key="HoverRowBrush" Color="{StaticResource HoverRowColor}"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentEdgeBrush" Color="{StaticResource AccentEdgeColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}"/>

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}"/>

    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="OkBgBrush" Color="{StaticResource OkBgColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="WarnBgBrush" Color="{StaticResource WarnBgColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource DangerBgColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBgColor}"/>
</ResourceDictionary>
