<local:ThemedWindow x:Class="AllStarsModManager.App.ApplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AllStarsModManager.App"
        Title="Apply changes" Width="700" Height="620" MinWidth="560" MinHeight="460"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="ApplyWindow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Height="0"/>
        <Grid Grid.Row="1" Margin="24,18,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="Apply changes" Style="{StaticResource PageTitle}" FontSize="18" AutomationProperties.AutomationId="ApplyTitle"/>
            <Border Grid.Row="1" Margin="0,10,0,10" Padding="10,7" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="2">
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" AutomationProperties.AutomationId="ApplyStatus"/>
            </Border>
            <ProgressBar x:Name="Bar" Grid.Row="2" IsIndeterminate="True" Margin="0,0,0,10"/>
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <StackPanel x:Name="BlockerPanel" Visibility="Collapsed">
                        <TextBlock Text="PROBLEMS — NOTHING WILL BE CHANGED UNTIL THESE ARE FIXED" Style="{StaticResource SectionTitle}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/>
                        <ItemsControl x:Name="BlockerList" ItemTemplate="{StaticResource NoteTemplate}" IsTabStop="False" AutomationProperties.AutomationId="BlockerList"/>
                    </StackPanel>
                    <StackPanel x:Name="ChangePanel" Visibility="Collapsed">
                        <TextBlock Text="WHAT WILL CHANGE" Style="{StaticResource SectionTitle}" Margin="0,4,0,6"/>
                        <ItemsControl x:Name="ChangeList" IsTabStop="False" AutomationProperties.AutomationId="ChangeList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Path Style="{StaticResource IconStroke}" Data="{StaticResource IconArrow}" Stroke="{StaticResource AccentTextBrush}" Width="12" Height="12" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel x:Name="NotePanel" Visibility="Collapsed">
                        <TextBlock Text="WORTH KNOWING" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl x:Name="NoteList" ItemTemplate="{StaticResource NoteTemplate}" IsTabStop="False" AutomationProperties.AutomationId="NoteList"/>
                    </StackPanel>
                    <StackPanel x:Name="LogPanel" Visibility="Collapsed">
                        <TextBlock Text="PROGRESS" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="LogText" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12" AutomationProperties.AutomationId="ApplyLog"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" MinWidth="96" Margin="0,0,8,0" IsCancel="True" AutomationProperties.AutomationId="ApplyCancelButton"/>
                <Button x:Name="ApplyButton" Content="Apply" Click="Apply_Click" Style="{StaticResource PrimaryButton}" MinWidth="130" IsEnabled="False" AutomationProperties.AutomationId="ApplyConfirmButton"/>
            </StackPanel>
        </Border>
    </Grid>
</local:ThemedWindow>
